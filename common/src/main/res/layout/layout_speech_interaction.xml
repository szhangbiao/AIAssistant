<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="510dp"
    android:layout_height="wrap_content"
    tools:orientation="vertical"
    tools:paddingBottom="24dp"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:id="@+id/tv_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="136dp"
        android:includeFontPadding="true"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        tools:text="您好，我是Bobo！" />

    <TextView
        android:id="@+id/tv_result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="136dp"
        android:includeFontPadding="true"
        android:text="@string/speech_initial_help"
        android:textColor="#AEAEAE"
        android:textSize="20sp"
        tools:text="想问什么尽管问我！" />

    <FrameLayout
        android:id="@+id/fl_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_answer_content"
        tools:minHeight="72dp">

        <TextView
            android:id="@+id/tv_npl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:layout_marginEnd="8dp"
            android:fadeScrollbars="false"
            android:focusable="false"
            android:lineSpacingExtra="2dp"
            android:maxHeight="304dp"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:scrollbarSize="6dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
            android:scrollbarTrackVertical="@drawable/scrollbar_track"
            android:scrollbars="vertical"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            tools:text="上午好！现在是北京时间2024年7月23日11:46。您所在的地区：苏州市今日小雨转多云，气温10°C，注意天冷加衣哦～"
            tools:visibility="gone" />

        <cn.booslink.llm.common.widget.LoadingView
            android:id="@+id/loadingView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:animationDuration="500"
            app:dotRadius="6dp"
            app:dotSpacing="20dp"
            app:enlargedColor="#FFFFFF"
            app:enlargedRadiusScale="1.5"
            app:normalColor="#CCCCCC" />

        <cn.booslink.llm.common.widget.WeatherListLayout
            android:id="@+id/cl_weather_list"
            android:layout_width="match_parent"
            android:layout_height="385dp"
            android:visibility="gone" />

        <cn.booslink.llm.common.widget.WakeUpLayout
            android:id="@+id/ll_wakeup"
            android:layout_width="match_parent"
            android:layout_height="278dp"
            android:visibility="gone" />
    </FrameLayout>

    <cn.booslink.llm.common.widget.ApkDownloadLayout
        android:id="@+id/fl_download_layout"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_answer_content"
        android:visibility="gone"
        tools:visibility="visible" />

    <cn.booslink.llm.common.widget.ApkDownloadLayout
        android:id="@+id/fl_download_dismiss"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_answer_content"
        android:visibility="gone"
        tools:visibility="visible" />
</merge>