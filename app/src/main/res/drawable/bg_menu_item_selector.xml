<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Focused state: active background -->
  <item android:state_focused="true" android:drawable="@drawable/bg_menu_item_active" />
  <!-- Selected but NOT focused: subtle background -->
  <item android:state_selected="true" android:drawable="@drawable/bg_menu_item_selected" />
  <!-- Default state: transparent -->
  <item android:drawable="@android:color/transparent" />
</selector>
